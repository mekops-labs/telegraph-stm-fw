build/
*.o
*.a
*.elf
*.bin
*.hex
*.map

# ccache lands here because the container HOME is the bind-mounted source
.cache/
.ccache/

# NuttX build outputs inside the submodule
third_party/nuttx/.config
third_party/nuttx/.config.old
third_party/nuttx/.version
third_party/nuttx/nuttx
third_party/nuttx/Make.defs
boards/*/scripts/ld.script.tmp
boards/*/src/Make.dep

# tools/genversion.sh writes this header at every build
boards/*/src/version.h

# The WiFi credentials of the tools stay out of the repository
credentials.ini
.pio/
__pycache__/
*.pyc

# The compiled wapps of the edge MCU
wapps/*/*.wasm
