{
  "wapps": [
    {
      "name": "tg-broker",
      "version": "VERSION",
      "image": "REGISTRY/tg/broker:VERSION",
      "policy": {
        "Drivers": [
          {
            "Name": "uart",
            "Options": "port=1,tx=1,rx=2,baud=460800,format=8N1"
          },
          {
            "Name": "pipe",
            "Options": "read=tg-display-req,write=tg-display-rsp,read=tg-ota-req,write=tg-ota-rsp"
          },
          {
            "Name": "pipe",
            "Options": "read=tg-time-req,write=tg-time-rsp,read=tg-usb-req,write=tg-usb-rsp"
          }
        ]
      },
      "args": [
        "display",
        "ota",
        "time",
        "usb:0x33"
      ]
    },
    {
      "name": "tg-display",
      "version": "VERSION",
      "image": "REGISTRY/tg/display:VERSION",
      "policy": {
        "Drivers": [
          {
            "Name": "pipe",
            "Options": "write=tg-display-req,read=tg-display-rsp,read=tgd-rest-req,write=tgd-rest-rsp,read=tgd-hass-req,write=tgd-hass-rsp"
          }
        ]
      },
      "args": [
        "rest",
        "hass"
      ]
    },
    {
      "name": "tg-rest",
      "version": "VERSION",
      "image": "REGISTRY/tg/rest:VERSION",
      "policy": {
        "Drivers": [
          {
            "Name": "pipe",
            "Options": "write=tgd-rest-req,read=tgd-rest-rsp"
          }
        ],
        "Sockets": [
          {
            "Name": "http",
            "Address": "tcp://0.0.0.0:8080",
            "Role": "listen",
            "Backlog": 2,
            "MaxConns": 2
          }
        ]
      }
    },
    {
      "name": "tg-hass",
      "version": "VERSION",
      "image": "REGISTRY/tg/hass:VERSION",
      "policy": {
        "Drivers": [
          {
            "Name": "pipe",
            "Options": "write=tgd-hass-req,read=tgd-hass-rsp"
          }
        ],
        "Sockets": [
          {
            "Name": "mqtt",
            "Address": "tcp://BROKER"
          }
        ]
      },
      "envs": [
        "HASS_DEVICE=telegraph-01",
        "HASS_NAME=Telegraph",
        "HASS_USER=MQTT_USER",
        "HASS_PASS=MQTT_PASS"
      ],
      "config": [
        {
          "path": "/etc/tg-hass.conf",
          "content": "interval_s=30"
        }
      ]
    },
    {
      "name": "tg-ota",
      "version": "VERSION",
      "image": "REGISTRY/tg/ota:VERSION",
      "restart": "never",
      "policy": {
        "Drivers": [
          {
            "Name": "gpio",
            "Options": "pins=boot0:4:out,nrst:5:out:init=1:drive=od"
          },
          {
            "Name": "pipe",
            "Options": "write=tg-ota-req,read=tg-ota-rsp"
          }
        ]
      }
    },
    {
      "name": "tg-time",
      "version": "VERSION",
      "image": "REGISTRY/tg/time:VERSION",
      "policy": {
        "Drivers": [
          {
            "Name": "rtc",
            "Options": "devices=main,set"
          },
          {
            "Name": "pipe",
            "Options": "write=tg-time-req,read=tg-time-rsp"
          }
        ]
      }
    },
    {
      "name": "tg-usb",
      "version": "VERSION",
      "image": "REGISTRY/tg/usb:VERSION",
      "policy": {
        "Drivers": [
          {
            "Name": "pipe",
            "Options": "write=tg-usb-req,read=tg-usb-rsp"
          }
        ],
        "Sockets": [
          {
            "Name": "http",
            "Address": "tcp://0.0.0.0:8081",
            "Role": "listen",
            "Backlog": 2,
            "MaxConns": 2
          }
        ]
      }
    },
    {
      "name": "tg-logs",
      "version": "VERSION",
      "image": "REGISTRY/tg/logs:VERSION",
      "policy": {
        "Drivers": [
          {
            "Name": "log",
            "Path": "/logs"
          }
        ],
        "Sockets": [
          {
            "Name": "http",
            "Address": "tcp://0.0.0.0:8082",
            "Role": "listen",
            "Backlog": 2,
            "MaxConns": 2
          }
        ]
      }
    }
  ]
}
