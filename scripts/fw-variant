#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Print this repository's version as a firmware image variant.
#
# A clean checkout of a release tag prints the release (`0.4.0`). Any other
# checkout prints `<last release>.dev.g<hash>`, with `.dirty` on a modified
# tree. The variant holds only [A-Za-z0-9._], as the image tag requires.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if tag=$(git -C "$ROOT" describe --tags --exact-match 2>/dev/null) &&
    [ -z "$(git -C "$ROOT" status --porcelain)" ]; then
    echo "${tag#v}"
    exit 0
fi

base=$(git -C "$ROOT" describe --tags --abbrev=0 2>/dev/null || echo v0.0.0)
hash=$(git -C "$ROOT" rev-parse --short=7 HEAD)
dirty=""
if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
    dirty=".dirty"
fi
echo "${base#v}.dev.g${hash}${dirty}"
